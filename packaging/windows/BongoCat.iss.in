#ifndef PayloadDir
  #error PayloadDir must point to the staged CMake Runtime component
#endif

[Setup]
; AppId 是升级身份键, 改名时刻意保持不变 —— 改了会变成并排安装的第二份程序, 用户会
; 在"应用和功能"里看到两个 BongoCat, 而且拿不到原安装目录。
AppId=BongoCat
AppName=@BONGO_CAT_DISPLAY_NAME@
AppVersion=@PROJECT_VERSION@
VersionInfoVersion=@PROJECT_VERSION@
VersionInfoTextVersion=@PROJECT_VERSION@
AppPublisher=vladelaina
AppPublisherURL=@PROJECT_HOMEPAGE_URL@
AppSupportURL=@PROJECT_HOMEPAGE_URL@
DefaultDirName={code:GetInstallDir}
DefaultGroupName=@BONGO_CAT_DISPLAY_NAME@
PrivilegesRequired=lowest
DisableProgramGroupPage=yes
DisableWelcomePage=yes
DisableDirPage=auto
UsePreviousAppDir=yes
OutputDir=@CMAKE_BINARY_DIR@/dist
OutputBaseFilename=@BONGO_CAT_PACKAGE_NAME@-setup
SetupIconFile=@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/icon.ico
UninstallDisplayIcon={app}\BongoCatTurbo.exe
Compression=zip
WizardStyle=modern
CloseApplications=yes
; 新老进程名都要列: 老版本(1.15.x 及更早)跑的是 BongoCat.exe, 升级时要让 Restart
; Manager 认得它, 否则覆盖安装时老实例还在后台跑。
CloseApplicationsFilter=BongoCatTurbo.exe,BongoCat.exe
RestartApplications=no
SetupLogging=yes
#if "@BONGO_CAT_PACKAGE_ARCH@" == "x64"
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
#endif

[Files]
Source: "{#PayloadDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{userdesktop}\BongoCat Turbo"; Filename: "{app}\BongoCatTurbo.exe"; Parameters: "--nearby-root=""{userdesktop}"""; WorkingDir: "{userdesktop}"
Name: "{userprograms}\BongoCat Turbo\BongoCat Turbo"; Filename: "{app}\BongoCatTurbo.exe"; Parameters: "--nearby-root=""{userprograms}\BongoCat Turbo"""; WorkingDir: "{userprograms}\BongoCat Turbo"
Name: "{userprograms}\BongoCat Turbo\Uninstall"; Filename: "{uninstallexe}"

[Run]
Filename: "{app}\BongoCatTurbo.exe"; Description: "Launch BongoCat Turbo"; Flags: nowait postinstall skipifsilent

[Code]
#include "install-lifecycle.iss"
